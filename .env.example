APP_NAME="Sistem Absensi Jaya Kedhaton"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# =====================================================================
# KONFIGURASI DATABASE POSTGRESQL (HOSTING & LOCAL)
# =====================================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistem_absensi
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# =====================================================================
# KEBIJAKAN RETENSI DATA HISTORIS & COLD STORAGE
# =====================================================================
DATA_RETENTION_MONTHS=0
FOTO_RETENTION_MONTHS=0
AUTO_PURGE_ENABLED=false

