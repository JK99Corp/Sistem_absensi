APP_NAME="Sistem Absensi Jaya Kedhaton"
APP_ENV=local
APP_KEY=base64:dGhpc2lzYWR1bW15a2V5Zm9ydGVzdGluZzEyMzQ1Ng==
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# =====================================================================
# KONFIGURASI DATABASE (POSTGRESQL & SQLITE)
# =====================================================================
# Untuk produksi / hosting cloud (Supabase, Neon, Railway, Render, dll):
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistem_absensi
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=prefer
# Jika menggunakan connection string langsung dari cloud provider:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Untuk testing lokal cepat tanpa install PostgreSQL:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# =====================================================================
# KEBIJAKAN RETENSI DATA HISTORIS & COLD STORAGE (SIAGA)
# =====================================================================
# 0 = Simpan Selamanya (Default: Data tidak akan pernah dihapus)
DATA_RETENTION_MONTHS=0
FOTO_RETENTION_MONTHS=0
AUTO_PURGE_ENABLED=false
