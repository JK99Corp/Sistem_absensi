{
    "name": "kantorjk/absensi-dig",
    "type": "project",
    "description": "Prototype Website Absensi RFID + Kamera KantorJK",
    "keywords": ["laravel", "absensi", "rfid", "esp32"],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

